<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>GeurtsPerformancePrefect</AssemblyName>
    <Product>Geurts Performance Prefect</Product>
    <Title>Geurts Performance Prefect</Title>
    <AssemblyTitle>Geurts Performance Prefect</AssemblyTitle>
    <Company>Geurts</Company>
    <RootNamespace>GeurtsPerformancePrefect</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Branding\prefect-emerald.ico</ApplicationIcon>
    <Version>1.44.1</Version>
    <HardwareToolsArchive>$(MSBuildProjectDirectory)\..\..\Build\HardwareTools\fastfetch-windows-amd64.zip</HardwareToolsArchive>
    <PlatformTarget>x64</PlatformTarget>
    <!-- WPF owns DPI awareness; Windows Forms is used only for the tray and monitor bounds. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\PresentMon\PresentMon.exe" LogicalName="Prefect.PresentMon.exe" />
    <EmbeddedResource Include="$(HardwareToolsArchive)" LogicalName="Prefect.Fastfetch.zip" Condition="Exists('$(HardwareToolsArchive)')" />
    <EmbeddedResource Include="Assets\WinDirStat\WinDirStat.exe" LogicalName="Prefect.WinDirStat.exe" />
    <EmbeddedResource Include="Assets\WinDirStat\WinDirStat-source.zip" LogicalName="Prefect.WinDirStat-source.zip" />
    <Resource Include="Assets\Branding\prefect-emerald.ico" />
    <Reference Include="Dependencies\*.dll" />
    <Content Include="Dependencies\**\*" Exclude="Dependencies\*.dll">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="RequireEmbeddedHardwareTools" BeforeTargets="PrepareForBuild" Condition="'$(RequireHardwareTools)' == 'true'">
    <Error Condition="!Exists('$(HardwareToolsArchive)')" Text="Prepare the pinned hardware helper with scripts/Get-HardwareTools.ps1 before building a release." />
  </Target>
</Project>
